{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "Pixel-art office that shows your running Claude Code sessions and sub-agents",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "visualization",
    "pixel-art",
    "dashboard"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-office": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "buddy",
    ".claude-plugin",
    "roles"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "tsx src/server/cli.ts",
    "laya": "tsx src/server/cli.ts laya",
    "start:all": "tsx src/server/cli.ts --with-laya --open",
    "demo": "tsx src/server/cli.ts --demo --open",
    "buddy:frames": "tsx scripts/buddy-frames.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
